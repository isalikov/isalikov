{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run check*)",
      "Bash(bunx astro check*)",
      "Bash(cat*)",
      "Bash(find*)",
      "Bash(grep*)",
      "Bash(head*)",
      "Bash(ls*)",
      "Bash(mise current*)",
      "Bash(mise doctor*)",
      "Bash(mise ls*)",
      "Bash(mise run check*)",
      "Bash(mise tasks*)",
      "Bash(mise which*)",
      "Bash(npm run check*)",
      "Bash(npm run typecheck*)",
      "Bash(npx astro check*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(pnpm astro check*)",
      "Bash(pnpm check*)",
      "Bash(pnpm exec astro check*)",
      "Bash(pnpm exec tsc --noEmit*)",
      "Bash(pnpm tsc --noEmit*)",
      "Bash(pnpm typecheck*)",
      "Bash(rg*)",
      "Bash(tail*)",
      "Bash(tree*)",
      "Bash(wc*)",
      "Glob",
      "Grep",
      "Read",
      "WebFetch(domain:astro.build)",
      "WebFetch(domain:docs.astro.build)"
    ],
    "deny": [
      "Bash(astro build*)",
      "Bash(astro dev*)",
      "Bash(astro preview*)",
      "Bash(bun run build*)",
      "Bash(bun run dev*)",
      "Bash(bun run test*)",
      "Bash(bun test*)",
      "Bash(git *)",
      "Bash(git)",
      "Bash(mise r build*)",
      "Bash(mise r dev*)",
      "Bash(mise r preview*)",
      "Bash(mise r test*)",
      "Bash(mise run build*)",
      "Bash(mise run dev*)",
      "Bash(mise run preview*)",
      "Bash(mise run test*)",
      "Bash(npm run build*)",
      "Bash(npm run dev*)",
      "Bash(npm run preview*)",
      "Bash(npm run test*)",
      "Bash(npm start*)",
      "Bash(npm test*)",
      "Bash(npx astro build*)",
      "Bash(npx astro dev*)",
      "Bash(npx astro preview*)",
      "Bash(npx playwright*)",
      "Bash(npx vitest*)",
      "Bash(playwright*)",
      "Bash(pnpm build*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm exec astro build*)",
      "Bash(pnpm exec astro dev*)",
      "Bash(pnpm exec astro preview*)",
      "Bash(pnpm exec playwright*)",
      "Bash(pnpm exec vitest*)",
      "Bash(pnpm preview*)",
      "Bash(pnpm run build*)",
      "Bash(pnpm run dev*)",
      "Bash(pnpm run test*)",
      "Bash(pnpm start*)",
      "Bash(pnpm test*)",
      "Bash(vitest*)",
      "Bash(yarn build*)",
      "Bash(yarn dev*)",
      "Bash(yarn start*)",
      "Bash(yarn test*)",
      "Edit(.git/**)"
    ]
  },
  "includeGitInstructions": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 10,
            "statusMessage": "Checking command against project rules"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/mark-changed.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-commit-message.sh",
            "timeout": 10,
            "statusMessage": "Checking for suggested commit message"
          }
        ]
      }
    ]
  }
}
